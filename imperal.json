{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.12",
  "app_id": "seo-audit-engine",
  "version": "1.0.0",
  "name": "SEO Audit Engine",
  "description": "Технический SEO-аудит портфеля сайтов: обход страниц, 18 правил в шести слоях, отчёты по каждому сайту и по портфелю, и готовые задачи для трекера. Только чтение — аудит ничего не меняет на сайтах.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "seo:audit",
    "seo:report"
  ],
  "tools": [
    {
      "name": "audit_sites",
      "description": "Запустить SEO-аудит одного или нескольких сайтов. Обходит страницы, проверяет 18 правил в шести слоях и записывает находки. Аудит только читает — ничего на сайтах не меняет. Долгие прогоны идут в фоне: подтверждение приходит сразу, итог — отдельным сообщением.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:audit_run"
      ],
      "id_projection": "",
      "params_schema": {
        "description": "Что проверять и насколько глубоко.",
        "properties": {
          "sites": {
            "default": "",
            "description": "Домены через запятую или с новой строки, например 'climtec.md, ksrenovationgroup.com'. Схему писать не нужно.",
            "title": "Sites",
            "type": "string"
          },
          "label": {
            "default": "",
            "description": "Название прогона, например 'июль, портфель агентства'",
            "title": "Label",
            "type": "string"
          },
          "max_pages": {
            "default": 50,
            "description": "Сколько страниц смотреть на каждом сайте. 50 хватает, чтобы увидеть системные дефекты.",
            "maximum": 500,
            "minimum": 1,
            "title": "Max Pages",
            "type": "integer"
          },
          "site_workers": {
            "default": 4,
            "description": "Сколько САЙТОВ обходить одновременно",
            "maximum": 16,
            "minimum": 1,
            "title": "Site Workers",
            "type": "integer"
          },
          "page_workers": {
            "default": 4,
            "description": "Сколько страниц одновременно внутри ОДНОГО сайта. Держите небольшим: это нагрузка на чужой сервер.",
            "maximum": 8,
            "minimum": 1,
            "title": "Page Workers",
            "type": "integer"
          }
        },
        "title": "AuditSitesParams",
        "type": "object"
      },
      "return_schema": {
        "description": "Подтверждение запуска: что именно началось и сколько это займёт.\n\nОценка времени здесь не украшение: аудит идёт минуты или десятки минут, и\nбез неё пользователь не понимает, ждать ему или заняться другим.",
